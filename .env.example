# DuriCare Frontend — Environment Variables
# Copy this file to .env.development (for local dev) or .env.production (for deploy).

# Backend API base URL (include /api suffix)
# Default: http://localhost:6767/api (Spring Boot dev server)
# Production: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:6767/api
